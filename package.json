{
  "name": "amazfit-sokoban",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Zepp OS mini app for Amazfit watches.",
  "license": "MIT",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "maps": "node scripts/generate-maps.mjs",
    "pack": "node scripts/pack-maps.mjs",
    "dev": "npm run pack && npx --yes @zeppos/zeus-cli@1.9.2 dev",
    "preview": "npm run pack && npx --yes @zeppos/zeus-cli@1.9.2 preview",
    "build": "npm run pack && npx --yes @zeppos/zeus-cli@1.9.2 build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.4.2",
    "vitest": "^4.1.10"
  }
}
