# ===== Node =====
node_modules/
npm-debug.log*
yarn-error.log*

# ===== Build output =====
# .zab is the Zepp App Store bundle; dist/ holds cover/screen images for the listing.
dist/
build/
*.zab
coverage/

# Zeus CLI cache and downloaded device targets
.zeus/
.download/

# The packed level collection: built from maps/*.sok by scripts/pack-maps.mjs
# before every dev, preview and build. The text in maps/ is the source of truth.
assets/common.r/levels.bin

# ===== Environment variables =====
.env
.env.*

# ===== Logs =====
*.log
logs/

# ===== IDEs =====
.vscode/
.zed/
.idea/
*.iml

# ===== AI agents =====
# .claude/ itself is tracked: it carries the project's agent context - CLAUDE.md,
# skills, shared settings - so a fresh session knows how to work here. Only the
# per-machine file stays out, because it accumulates absolute paths and one-off
# command approvals that mean nothing on anyone else's computer.
.claude/settings.local.json
.claude/*.local.json
.cursor/
.windsurf/
.gemini/
.aider*
.continue/

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Temporary files (never committed, holds working context) =====
tmp/
temp/
